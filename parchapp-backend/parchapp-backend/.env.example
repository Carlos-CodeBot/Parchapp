# ─── Servidor ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# En desarrollo local la app nativa no depende de CORS. Usa * para Expo Web.
CORS_ORIGIN=*

# ─── JWT ─────────────────────────────────────────────────────
# Genera uno seguro con: openssl rand -hex 64
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=30d

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=parchapp
POSTGRES_USER=parchapp
POSTGRES_PASSWORD=parchapp_local_password

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── MinIO (almacenamiento de fotos) ─────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=parchapp_access
MINIO_SECRET_KEY=parchapp_local_secret
MINIO_BUCKET=parchapp-fotos
MINIO_USE_SSL=false

# ─── URL pública del servidor (para las URLs de las fotos) ───
# Para un teléfono físico reemplaza localhost por la IP LAN del computador.
PUBLIC_URL=http://localhost
