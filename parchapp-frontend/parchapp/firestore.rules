// firestore.rules
// Copia esto en Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios: solo el dueño puede editar su perfil
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // Parchaderos: cualquier usuario autenticado puede crear y leer
    // Solo el creador puede editar o eliminar
    match /parchaderos/{parchaderoId} {
      allow read: if true; // Público, para que el mapa funcione sin login
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // El creador puede actualizar todo
        resource.data.creadoPor == request.auth.uid ||
        // Cualquier usuario autenticado puede agregar fotos y calificaciones
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fotos', 'calificacionPromedio', 'totalCalificaciones'])
      );
      allow delete: if request.auth.uid == resource.data.creadoPor;

      // Calificaciones: cada usuario solo puede escribir la suya
      match /calificaciones/{usuarioId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == usuarioId;
      }
    }

    // Comentarios: autenticados pueden leer y crear
    match /comentarios/{comentarioId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth.uid == resource.data.usuarioId;
    }
  }
}
